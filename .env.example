# Copy this file to .env.local and fill in the values yourself.
# Never paste real values into chat, and never commit .env.local.

# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser, protected by database rules)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role / secret key (SERVER ONLY, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# The only email address allowed to use the app
ALLOWED_EMAIL=

# FAL.AI API key for draft beats (SERVER ONLY)
FAL_KEY=
# FAL.AI model ID for MiniMax Music (from the FAL model page)
FAL_MINIMAX_MODEL_ID=
# ElevenLabs API key for release-grade beats (SERVER ONLY)
ELEVENLABS_API_KEY=
# Optional: MiniMax direct API key (SERVER ONLY). Leave blank if unused
MINIMAX_API_KEY=
# "true" only after upgrading ElevenLabs to a paid plan; controls the release-ready label
ELEVENLABS_PLAN_IS_PAID=false
# Max generations per day (app-level spending safety net), e.g. 25
DAILY_GENERATION_LIMIT=25
